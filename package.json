{
  "name": "outdated-plus",
  "version": "2.0.0",
  "description": "Show every direct dependency with installed and latest version and their release dates. Works with npm, pnpm, yarn and bun.",
  "keywords": [
    "outdated",
    "dependencies",
    "cli",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "release-date"
  ],
  "homepage": "https://github.com/AlexF090/outdated-plus#readme",
  "bugs": {
    "url": "https://github.com/AlexF090/outdated-plus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexF090/outdated-plus.git"
  },
  "license": "MIT",
  "author": "AlexF090",
  "type": "module",
  "bin": {
    "outdated-plus": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "pnpm typecheck && pnpm format:check && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
